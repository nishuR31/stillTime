{
  "name": "stilltime",
  "version": "1.0.0",
  "description": "Android screen timeout utility. Change your real screen-off timeout without opening Android Settings.",
  "private": false,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "prebuild:android": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-modules-core": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2"
  }
}
<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal RemoteViews layout.

    RemoteViews supports only a fixed set of widgets, so this is deliberately
    plain: LinearLayout, TextView and ImageView only. No data binding, no
    collections, no RemoteViewsService — which is also why Stilltime does not
    need ACCESS_NETWORK_STATE.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:contentDescription="@string/widget_description">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_status_ready"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted" />

        <ImageView
            android:id="@+id/widget_open"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_open"
            android:contentDescription="@string/widget_open"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_value_placeholder"
        android:textSize="34sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="@color/widget_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_preset_1"
            style="@style/Widget.Preset"
            android:contentDescription="@string/widget_preset_30s" />

        <TextView
            android:id="@+id/widget_preset_2"
            style="@style/Widget.Preset"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_preset_1m" />

        <TextView
            android:id="@+id/widget_preset_3"
            style="@style/Widget.Preset"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_preset_5m" />

        <TextView
            android:id="@+id/widget_preset_4"
            style="@style/Widget.Preset"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_preset_15m" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stay_awake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        android:background="@drawable/widget_button_background"
        android:text="@string/widget_stay_awake_toggle"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent_text"
        android:contentDescription="@string/widget_stay_awake_toggle_description" />

</LinearLayout>